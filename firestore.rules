rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Helper: check if user is admin
    function isAdmin() {
      return isAuth() && request.auth.token.email == 'admin@leadforge.ai';
    }

    // SETTINGS - only authenticated users
    match /settings/{doc} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    // KEYWORDS - only authenticated users
    match /keywords/{doc} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // KEYWORD RUNS - only authenticated users
    match /keyword_runs/{doc} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if false;
    }

    // LEADS - only authenticated users
    match /leads/{doc} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // SEARCH QUERIES - only authenticated users
    match /search_queries/{doc} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // EMAIL TEMPLATES - only authenticated users
    match /email_templates/{doc} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // OUTREACH JOBS - only authenticated users
    match /outreach_jobs/{doc} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if false;
    }

    // OUTREACH MESSAGES - only authenticated users
    match /outreach_messages/{doc} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if false;
    }

    // SENDING ACCOUNTS - only authenticated users
    match /sending_accounts/{doc} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // REPLIES - only authenticated users
    match /replies/{doc} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if false;
    }

    // NOTIFICATIONS - only authenticated users
    match /notifications/{doc} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // ACTIVITY LOGS - append only (no delete)
    match /activity_logs/{doc} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if false;
      allow delete: if false;
    }

    // ANALYTICS DAILY - only authenticated users
    match /analytics_daily/{doc} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if false;
    }

    // INTEGRATION LOGS - append only
    match /integration_logs/{doc} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if false;
      allow delete: if false;
    }

    // MONTHLY CYCLES - only authenticated users
    match /monthly_cycles/{doc} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if false;
    }

    // DEFAULT: deny all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
